{
  "name": "matrimonial-app-backend",
  "version": "1.0.0",
  "description": "Matrimonial Web Application Backend - Node.js + Express + Prisma + PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:db:migrate": "docker-compose exec backend npm run prisma:deploy",
    "docker:db:studio": "docker-compose exec backend npm run prisma:studio",
    "production:start": "npx prisma migrate deploy && node server.js"
  },
  "keywords": [
    "matrimonial",
    "backend",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.6",
    "redis": "^4.7.1",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
