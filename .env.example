# ============================================
# Matrimonial App - Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# cp .env.example .env

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port (default: 3000)
PORT=3000

# Environment (development/production)
NODE_ENV=development

# Client URL for CORS (optional, defaults to "*")
CLIENT_URL=http://localhost:3000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL database connection URL
# Format: postgresql://username:password@host:port/database?schema=schema
DATABASE_URL="postgresql://postgres:password@localhost:5432/matrimonial_db?schema=public"

# ============================================
# REDIS CACHE CONFIGURATION
# ============================================

# Redis connection URL
# Format: redis://host:port or redis://username:password@host:port
REDIS_URL="redis://localhost:6379"

# ============================================
# AUTHENTICATION & JWT
# ============================================

# JWT secret key for access token signing (REQUIRED - change in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT access token expiration time
JWT_EXPIRES_IN="7d"

# JWT refresh token secret key (REQUIRED - change in production)
JWT_REFRESH_SECRET="your-refresh-token-secret"

# JWT refresh token expiration time
JWT_REFRESH_EXPIRES_IN="30d"

# ============================================
# SMS SERVICE CONFIGURATION
# ============================================

# SMS service provider (console/twilio/aws-sns)
# console: Logs OTP to console (development)
# twilio: Twilio SMS service
# aws-sns: AWS SNS SMS service
SMS_SERVICE=console

# --------------------------------------------
# TWILIO SMS SERVICE (if SMS_SERVICE=twilio)
# --------------------------------------------

# Twilio Account SID
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio phone number (E.164 format)
TWILIO_PHONE_NUMBER=+1234567890

# --------------------------------------------
# AWS SNS SMS SERVICE (if SMS_SERVICE=aws-sns)
# --------------------------------------------

# AWS region
AWS_REGION=us-east-1

# AWS Access Key ID
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ============================================
# PAYMENT GATEWAY (RAZORPAY)
# ============================================

# Razorpay Key ID (test or live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (for payment verification)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# FILE STORAGE (CLOUDFLARE R2)
# ============================================

# Cloudflare R2 Account ID
R2_ACCOUNT_ID=85d5534a60594e5a9b5b98b068aea109

# R2 Access Key ID
R2_ACCESS_KEY_ID=ca3b32aaa712f2e039f6a789fc5599a9

# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=b95db8991a04c0fb8bc6de25d492c235be7f2dc6853fffd369c25c67d35748b4

# R2 Bucket Name
R2_BUCKET_NAME=development-bucket

# R2 Endpoint URL
R2_ENDPOINT=https://85d5534a60594e5a9b5b98b068aea109.r2.cloudflarestorage.com

# R2 Public URL (optional - custom domain)
# R2_PUBLIC_URL=https://your-custom-domain.com

# ============================================
# OPTIONAL SERVICES
# ============================================

# Logging level (debug/info/warn/error)
LOG_LEVEL=info

# API rate limiting (requests per window)
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100  # 100 requests per window

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Enable/disable development features
# DEV_SHOW_OTP=true  # Show OTP in response during development