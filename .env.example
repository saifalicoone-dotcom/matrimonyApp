# ============================================
# Matrimonial App - Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# cp .env.example .env

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/matrimonial_db?schema=public"

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Cloudflare R2 Storage (File Storage)
# ============================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-custom-domain.com

# ============================================
# Razorpay Payment Gateway
# ============================================
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: For webhook signature verification
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# SMS Service (OTP)
# ============================================
# Options: "console", "twilio", "aws-sns"
SMS_SERVICE=console

# Twilio Configuration (if SMS_SERVICE=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS Configuration (if SMS_SERVICE=aws-sns)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
