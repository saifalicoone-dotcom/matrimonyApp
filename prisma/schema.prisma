generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String               @id @default(uuid())
  email                  String?              @unique
  phone                  String               @unique
  passwordHash           String?
  role                   Role                 @default(USER)
  isEmailVerified        Boolean              @default(false)
  isPhoneVerified        Boolean              @default(false)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  lastActive             DateTime             @default(now())
  blockedBy              BlockList[]          @relation("BlockedUsers")
  blockedUsers           BlockList[]          @relation("BlockerUsers")
  chattedWithUsers       ChatUser[]           @relation("ChattedWithUsers")
  chatUsers              ChatUser[]           @relation("UserChats")
  sentInterests          Interest[]           @relation("SentInterests")
  receivedInterests      Interest[]           @relation("ReceivedInterests")
  sentMessages           Message[]            @relation("SentMessages")
  receivedMessages       Message[]            @relation("ReceivedMessages")
  notifications          Notification[]
  photoAccessRequestsFor PhotoAccessRequest[] @relation("PhotoAccessOwner")
  photoAccessRequests    PhotoAccessRequest[] @relation("PhotoAccessRequester")
  photos                 Photo[]
  profile                Profile?
  reportsReceived        Report[]             @relation("ReportReported")
  reportsSubmitted       Report[]             @relation("ReportReporter")
  shortlistedBy          Shortlist[]          @relation("ShortlistedUsers")
  shortlists             Shortlist[]          @relation("UserShortlists")
  subscriptions          Subscription[]
  walletTransactions     WalletTransaction[]
  wallet                 Wallet?

  @@map("users")
}

model Profile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  firstName            String
  lastName             String?
  dateOfBirth          DateTime
  age                  Int
  gender               Gender
  height               Float?
  maritalStatus        MaritalStatus @default(NEVER_MARRIED)
  email                String
  phone                String?
  withContact          Boolean       @default(false)
  education            String?
  occupation           String?
  income               String?
  country              String?
  state                String?
  city                 String?
  address              String?
  religion             String?
  caste                String?
  subCaste             String?
  community            String?
  motherTongue         String?
  familyType           String?
  fatherOccupation     String?
  motherOccupation     String?
  diet                 Diet?
  smoking              Boolean       @default(false)
  drinking             Boolean       @default(false)
  aboutMe              String?
  partnerPreferences   String?
  isVerified           Boolean       @default(false)
  verificationDocument String?
  profileVisible       Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  highestQualification String?
  numberOfBrothers     Int?          @default(0)
  numberOfChildren     Int?
  numberOfSisters      Int?          @default(0)
  profileFor           ProfileFor    @default(SELF)
  marriedBrothers      Int?          @default(0)
  marriedSisters       Int?          @default(0)
  faceEncoding         Json?
  faceVerificationDate DateTime?
  faceVerified         Boolean       @default(false)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([religion, caste])
  @@index([country, state, city])
  @@map("profiles")
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isPrivate Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Interest {
  id              String   @id @default(uuid())
  fromUserId      String
  toUserId        String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  contactUnlocked Boolean  @default(false)
  fromUser        User     @relation("SentInterests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser          User     @relation("ReceivedInterests", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@map("interests")
}

model Shortlist {
  id                String   @id @default(uuid())
  userId            String
  shortlistedUserId String
  createdAt         DateTime @default(now())
  shortlistedUser   User     @relation("ShortlistedUsers", fields: [shortlistedUserId], references: [id], onDelete: Cascade)
  user              User     @relation("UserShortlists", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortlistedUserId])
  @@map("shortlists")
}

model Message {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  fromUser   User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planType  String
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)
  paymentId String?
  amount    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model ChatUser {
  id         String   @id @default(uuid())
  userId     String
  chatUserId String
  createdAt  DateTime @default(now())
  chatUser   User     @relation("ChattedWithUsers", fields: [chatUserId], references: [id], onDelete: Cascade)
  user       User     @relation("UserChats", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatUserId])
  @@index([userId])
  @@map("chat_users")
}

model BlockList {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())
  blockedUser   User     @relation("BlockedUsers", fields: [blockedUserId], references: [id], onDelete: Cascade)
  user          User     @relation("BlockerUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
  @@map("blocklists")
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  type          String
  title         String
  message       String
  isRead        Boolean  @default(false)
  relatedUserId String?
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  purpose   String?  @default("verification") @db.VarChar(50)

  @@index([phone, isUsed])
  @@index([purpose], map: "idx_otps_purpose")
  @@map("otps")
}

model PhotoAccessRequest {
  id          String   @id @default(uuid())
  requesterId String
  ownerId     String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("PhotoAccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requester   User     @relation("PhotoAccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, ownerId])
  @@index([ownerId, status])
  @@index([requesterId])
  @@map("photo_access_requests")
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id                String          @id @default(uuid())
  walletId          String
  type              TransactionType
  amount            Float
  balanceAfter      Float
  description       String?
  referenceId       String?
  referenceType     String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentStatus     String?         @default("PENDING")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  userId            String?
  User              User?           @relation(fields: [userId], references: [id])
  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([referenceId, referenceType])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("wallet_transactions")
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reportedUserId String
  type           ReportType
  reason         String?
  status         ReportStatus @default(PENDING)
  adminNotes     String?
  adminAction    String?
  refundAmount   Float?
  refundedAt     DateTime?
  reviewedBy     String?
  reviewedAt     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reportedUser   User         @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, reportedUserId, type])
  @@index([reportedUserId, status])
  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  ANNULLED
  AWAITING_DIVORCE
}

enum ProfileFor {
  SELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  RELATIVE
  FRIEND
}

enum Diet {
  VEGETARIAN
  VEGAN
  NON_VEGETARIAN
  JAIN
  EGGETARIAN
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ReportType {
  ALREADY_MARRIED
  FAKE_PROFILE
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}
